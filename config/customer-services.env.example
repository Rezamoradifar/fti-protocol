# Optional web-service settings. Keep the installed environment file mode 0600.
# Guided help, consent-based intake and the guardian inbox need no AI key.
FTI_CUSTOMER_DATA_DIR=/var/lib/fti-customer-services/REPLACE_CHAIN_AND_BINARY

# Enable only when a loopback reverse proxy overwrites X-Real-IP with the
# connecting visitor address. Never trust an arbitrary X-Forwarded-For header.
# FTI_CUSTOMER_TRUST_PROXY=loopback

# AI matching is opt-in for each visitor. It selects approved support topics;
# it cannot change financial terms, sign, contact a lead or operate a wallet.
FTI_ASSISTANT_PROVIDER=none
# To activate, set provider=openai plus a model supporting structured outputs.
# Set the model available in the project's provider account; no paid default.
# FTI_ASSISTANT_MODEL=REPLACE_WITH_APPROVED_MODEL
# FTI_ASSISTANT_API_KEY_FILE=/etc/fti/customer-services/openai.key
# Or set OPENAI_API_KEY securely in the private service environment, not both.
FTI_ASSISTANT_DAILY_REQUEST_LIMIT=20

# VPN checkout remains unavailable with these settings omitted. Prepare a real
# acceptance manifest only after payment-to-delivery and owner access tests.
# FTI_VPN_MANIFEST_FILE=/etc/fti/customer-services/nodeshield-acceptance.json
# FTI_VPN_ALLOWED_HOSTS=REPLACE_WITH_VERIFIED_PROVIDER_HOSTNAME
