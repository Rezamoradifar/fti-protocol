# Template only. Not a service activation command. Keep actual files mode 0600.
# Use a separate verified release/config from the still-running testnet services.
DEPLOYMENT_FILE=/REQUIRED/verified-mainnet-deployment.json
RPC_URL=https://REQUIRED_MAINNET_RPC
HOST=127.0.0.1
PORT=3112
# Set a WalletConnect project ID for QR/mobile pairing; injected wallets also work.
WALLETCONNECT_PROJECT_ID=
# Optional archive RPC for market history; leave absent unless configured.
# EVENT_RPC_URL=https://REQUIRED_MAINNET_ARCHIVE_RPC
# Keep the gas-only Keeper key in a separate private service environment file.
# KEEPER_PRIVATE_KEY=SET_SECURELY_ON_SERVER_ONLY
KEEPER_INTERVAL_MS=5000
