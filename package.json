{
  "name": "fti-protocol",
  "version": "0.2.0",
  "description": "FTI independent local/testnet release candidate \u2014 not audited",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node --test --test-concurrency=1 test/*.test.mjs",
    "start": "node scripts/server.mjs",
    "demo": "npm run compile && node scripts/local.mjs",
    "keeper": "node scripts/keeper.mjs",
    "deploy": "npm run compile && node scripts/deploy.mjs",
    "simulate": "node scripts/simulate.mjs",
    "launch": "node scripts/launch-server.mjs",
    "import:deployment": "node scripts/import-browser-deployment.mjs",
    "build:web": "node scripts/build-web.mjs",
    "prestart": "npm run build:web",
    "predemo": "npm run build:web",
    "demo:reserve": "npm run build:web && npm run compile && node scripts/local.mjs --reserve-token",
    "test:reserve": "npm run compile && node --test --test-concurrency=1 test/reserve-*.test.mjs",
    "simulate:reserve": "node scripts/simulate-reserve.mjs 300000 docs/reserve-simulation-300000.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "ganache": "7.9.2",
    "solc": "0.8.30"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
