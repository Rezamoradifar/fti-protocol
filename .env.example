# TESTNET ONLY. Keep private keys on your server; never send them in chat.
RPC_URL=https://YOUR_BNB_TESTNET_RPC
DEPLOYMENT_FILE=deployments/testnet.json
CONFIG_FILE=deployments/testnet-input.json
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=5000
HOST=127.0.0.1
PORT=3000

# FTI V3 testnet deployment
V3_DEPLOYMENT_FILE=deployments/v3-testnet.json
V3_TESTNET_SECRETS=deployments/v3-testnet-secrets.json
DAO_CONFIG=config/v3-partner-dao.json

# Optional: enables explorer source verification after V3 testnet deployment
ETHERSCAN_API_KEY=
V3_VERIFICATION_FILE=deployments/v3-testnet-verification.json
